---
layout: base.njk
title: Leistungen
permalink: /leistungen/
---

<section class="page-hero">
  <div class="container">
    <h1>{{ leistungen.title }}</h1>
    <p class="subtitle">{{ leistungen.subtitle }}</p>
  </div>
</section>

<section class="section section-white">
  <div class="container fade-in">
    <p style="margin-bottom: 0">{{ leistungen.intro }}</p>
  </div>
</section>

<section class="section section-beige">
  <div class="container fade-in">
    <div class="grid-3" style="margin-top: 0">
      {% for item in leistungen.items %}
      <div class="card">
        <h3>{{ item.title }}</h3>
        <p>{{ item.text }}</p>
        <a href="{{ item.link }}" class="btn btn-secondary">Mehr erfahren</a>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section-white">
  <div class="container fade-in">
    <h2 class="text-center">Meine Arbeitsweise</h2>
    <div class="arbeitsweise-steps">
      <div class="arbeitsweise-step">
        <span class="arbeitsweise-number">1</span>
        <span class="arbeitsweise-text">Analyse</span>
      </div>
      <div class="arbeitsweise-arrow">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1E2F4F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </div>
      <div class="arbeitsweise-step">
        <span class="arbeitsweise-number">2</span>
        <span class="arbeitsweise-text">Struktur</span>
      </div>
      <div class="arbeitsweise-arrow">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1E2F4F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </div>
      <div class="arbeitsweise-step">
        <span class="arbeitsweise-number">3</span>
        <span class="arbeitsweise-text">Umsetzung</span>
      </div>
      <div class="arbeitsweise-arrow">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1E2F4F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </div>
      <div class="arbeitsweise-step">
        <span class="arbeitsweise-number">4</span>
        <span class="arbeitsweise-text">Begleitung</span>
      </div>
    </div>
  </div>
</section>

<section class="cta-section">
  <div class="container text-center">
    <h2>Lassen Sie uns über Ihre Ziele sprechen.</h2>
    <a href="/kontakt/" class="btn btn-hero">Erstgespräch vereinbaren</a>
  </div>
</section>
