---
layout: base.njk
title: Referenzen
permalink: /referenzen/
---

<section class="page-hero">
  <div class="container">
    <h1>{{ referenzen.title }}</h1>
    <p class="subtitle">{{ referenzen.subtitle }}</p>
  </div>
</section>

<section class="section section-white">
  <div class="container fade-in">
    <p>{{ referenzen.intro }}</p>
  </div>
</section>

<section class="section section-beige">
  <div class="container fade-in">
    <div class="grid-3">
      {% for category in referenzen.categories %}
      <div class="card">
        <h3>{{ category.title }}</h3>
        <p>{{ category.text }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section-white">
  <div class="container fade-in">
    <p><em>{{ referenzen.note }}</em></p>
  </div>
</section>

<section class="cta-section">
  <div class="container text-center">
    <h2>Lassen Sie uns über Ihre Ziele sprechen.</h2>
    <a href="/kontakt/" class="btn btn-hero">Erstgespräch vereinbaren</a>
  </div>
</section>
