<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} - {{ site.name }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="site-logo">
        <img src="/images/logo.jpeg" alt="{{ site.name }} Logo">
        <div class="site-logo-text">
          <span class="site-name">{{ site.name }}</span>
          <span class="site-subtitle">{{ site.owner }}</span>
        </div>
      </a>

      <button class="mobile-toggle" aria-label="Menü öffnen">
        <span></span>
        <span></span>
        <span></span>
      </button>

      <nav class="main-nav">
        <ul>
          <li><a href="/">Startseite</a></li>
          <li class="has-dropdown">
            <a href="/leistungen/">Leistungen</a>
            <ul class="dropdown">
              <li><a href="/leistungen/zertifizierungsberatung/">Zertifizierungsberatung</a></li>
              <li><a href="/leistungen/kommunen-tourismus/">Kommunen & Tourismus</a></li>
              <li><a href="/leistungen/gastronomie-hotellerie/">Gastronomie & Hotellerie</a></li>
            </ul>
          </li>
          <li><a href="/coaching/">Coaching</a></li>
          <li><a href="/ueber-mich/">Über mich</a></li>
          <li><a href="/referenzen/">Referenzen</a></li>
          <li><a href="/kontakt/">Kontakt</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-inner">
        <div class="footer-brand">
          <strong>{{ site.name }}</strong>
          <p>{{ site.tagline }}</p>
        </div>
        <nav class="footer-nav">
          <ul>
            <li><a href="/impressum/">Impressum</a></li>
            <li><a href="/datenschutz/">Datenschutz</a></li>
            <li><a href="/kontakt/">Kontakt</a></li>
          </ul>
        </nav>
      </div>
      <div class="footer-bottom">
        <p>&copy; 2026 {{ site.name }} &ndash; {{ site.owner }}</p>
      </div>
    </div>
  </footer>

  <script src="/js/main.js"></script>
</body>
</html>
