---
layout: base.njk
title: Coaching
permalink: /coaching/
---

<section class="page-hero">
  <div class="container">
    <h1>{{ coaching.title }}</h1>
    <p class="subtitle">{{ coaching.subtitle }}</p>
  </div>
</section>

<section class="section section-white">
  <div class="container fade-in">
    <p style="margin-bottom: 0">{{ coaching.intro }}</p>
  </div>
</section>

<section class="section section-beige">
  <div class="container fade-in">
    <h2>Für wen?</h2>
    <ul class="features-list">
      {% for item in coaching.target_group %}
      <li>{{ item }}</li>
      {% endfor %}
    </ul>
  </div>
</section>

<section class="section section-white">
  <div class="container fade-in">
    <h2 class="text-center">Coaching-Schwerpunkte</h2>
    <div class="grid-3">
      {% for schwerpunkt in coaching.schwerpunkte %}
      <div class="card schwerpunkt-card">
        <h3>{{ schwerpunkt.title }}</h3>
        <ul class="schwerpunkt-list">
          {% for item in schwerpunkt.items %}
          <li>{{ item }}</li>
          {% endfor %}
        </ul>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section-beige">
  <div class="container fade-in">
    <h2>Meine Coaching-Haltung</h2>
    <p style="margin-bottom: 0">{{ coaching.haltung }}</p>
  </div>
</section>

<section class="section section-white">
  <div class="container fade-in">
    <h2 class="text-center">Ablauf</h2>
    <div class="ablauf-steps">
      {% for step in coaching.ablauf %}
      <div class="ablauf-step">
        <span class="ablauf-number">{{ loop.index }}</span>
        <span class="ablauf-text">{{ step }}</span>
      </div>
      {% if not loop.last %}
      <div class="ablauf-arrow">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1E2F4F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
      </div>
      {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<section class="cta-section">
  <div class="container text-center">
    <h2>Lassen Sie uns ins Gespräch kommen.</h2>
    <a href="/kontakt/" class="btn btn-hero">Erstgespräch vereinbaren</a>
  </div>
</section>
